# Safe local defaults. Replace provider values through your deployment secret store.
OCR_ENVIRONMENT=development
OCR_REDIS_URL=redis://localhost:6379/0
OCR_WORKSPACE_ROOT=.data/jobs
OCR_FRONTEND_DIST=
OCR_ARTIFACT_TTL_SECONDS=3600
OCR_MAX_UPLOAD_BYTES=15000000
OCR_MAX_PDF_PAGES=12
OCR_HOSTED_PROVIDER_ENABLED=false
OCR_HOSTED_PROVIDER_BASE_URL=
OCR_HOSTED_PROVIDER_MODEL=
OCR_HOSTED_PROVIDER_API_KEY=
OCR_HOSTED_QUOTA_LIMIT=20
OCR_HOSTED_QUOTA_WINDOW_SECONDS=86400
